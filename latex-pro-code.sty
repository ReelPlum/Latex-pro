% latex-pro-code.sty -- Python and pseudocode listings (part of latex-pro)
%
% Usage:  \usepackage{latex-pro}  or  \usepackage{latex-pro-code}
%
% Commands
%   \python{code/solve.py}         include a .py file as highlighted Python in
%                                  an IDE-style box (listings + tcolorbox,
%                                  works with plain pdflatex)
%   \python[caption=Solver]{f.py}  caption/title go in the header bar, any
%                                  other listings option, e.g. firstline=5
%   \python*{f.py}                 same, without line numbers
%   \python[span]{f.py}            let a long listing break across pages
%                                  (default: the box is kept in one piece)
%   \begin{pythoncode} ... \end{pythoncode}   Python typed in the .tex file
%   \py{x = 1}                     short inline Python inside a sentence
%   \method{merge}                 a function name in the text, styled like
%                                  function names in the code blocks
%   \pseudo{algo.txt}              include a pseudocode .txt file: keywords
%                                  (if/then/else/for/while/repeat/return/end
%                                  ...) highlighted, \geq \leq \gets <= != ... as
%                                  maths, and indented automatically
%   \pseudo[caption=..]{f.txt}  \pseudo*{f.txt}   same options as \python
%   \python[filename=false]{f.py}  no file name on the right of the header
%                                  (also \pseudo; caption=.. replaces it)
%   \begin{pseudo} ... \end{pseudo}   pseudocode typed in the .tex file,
%                                  same handling as \pseudo (also pseudo*,
%                                  and the longer name pseudocode)
%   \pseudoindentfalse             keep the file's own indentation
%   Restyle with \lstdefinestyle{latexpro-python}{...} (or latexpro-pseudo).
%
\NeedsTeXFormat{LaTeX2e}[2020/10/01]
\ProvidesPackage{latex-pro-code}[2026/11/04 v0.4 latex-pro: code listings]

\RequirePackage{listings}

% ---------------------------------------------------------------------------
% Look: IDE-style boxes (light mode)
% ---------------------------------------------------------------------------
% Every block is a rounded box with a header bar naming the language (and the
% caption or file name on the right), a rule under it, a monospace font and
% GitHub-light colours. Function names are in small caps. Change a colour with \definecolor after loading,
% e.g. \definecolor{latexpro@keyword}{HTML}{D73A49}, the font with
% \renewcommand\latexprocodefont{\ttfamily}, the box with
% \tcbset{latexpro-code/.append style={...}}.
\newcommand\latexprocodefont{\ttfamily}
% function / method names (merge in "function merge(A, B)", newton in
% "def newton(x)" and wherever they are called) are set in small caps, like
% \textsc{merge}; \renewcommand\latexprofunctionfont{} turns that off.
\newcommand\latexprofunctionfont{\scshape}
% the whole look of a function name, shared by listings and \method
\newcommand\latexpro@functionstyle{\color{latexpro@function}\latexprofunctionfont}
% \method{merge}: a function / method name in running text, in the same
% font, colour and small caps as in the code blocks
\NewDocumentCommand\method{m}{{\latexprocodefont\latexpro@functionstyle #1}}
\newif\iflatexpro@fn
\newcommand\latexpro@fnnext{\global\latexpro@fntrue}
% identifiers: the name right after def / class / function is a function name
\newcommand\latexpro@ident{%
  \iflatexpro@fn\global\latexpro@fnfalse\latexpro@functionstyle\fi}
% xcolor and tcolorbox are loaded at \begin{document} if the document has not
% loaded them, so \usepackage[...]{xcolor} anywhere in the preamble never gives
% an option clash.
\AddToHook{begindocument/before}{%
  \@ifpackageloaded{xcolor}{}{\RequirePackage{xcolor}}%
  \@ifpackageloaded{tcolorbox}{}{\RequirePackage{tcolorbox}}%
  \tcbuselibrary{breakable}%
  \providecolor{latexpro@codebg}{HTML}{F6F8FA}%
  \providecolor{latexpro@codeframe}{HTML}{D0D7DE}%
  \providecolor{latexpro@header}{HTML}{24292F}%
  \providecolor{latexpro@headerinfo}{HTML}{57606A}%
  \providecolor{latexpro@text}{HTML}{24292F}%
  \providecolor{latexpro@keyword}{HTML}{CF222E}%
  \providecolor{latexpro@function}{HTML}{8250DF}%
  \providecolor{latexpro@builtin}{HTML}{8250DF}%
  \providecolor{latexpro@constant}{HTML}{0550AE}%
  \providecolor{latexpro@string}{HTML}{0A3069}%
  \providecolor{latexpro@comment}{HTML}{6E7781}%
  \providecolor{latexpro@number}{HTML}{8C959F}%
  \tcbset{latexpro-code/.style={
    colback=latexpro@codebg, colframe=latexpro@codeframe,
    colbacktitle=latexpro@codebg, coltitle=latexpro@header,
    fonttitle=\sffamily\small,
    boxrule=0.6pt, titlerule=0.6pt, arc=6pt,
    left=10pt, right=10pt, top=4pt, bottom=6pt,
    lefttitle=10pt, righttitle=10pt, toptitle=3pt, bottomtitle=3pt,
    before skip=\medskipamount, after skip=\medskipamount}}%
}
% the parts every code style shares
\lstdefinestyle{latexpro-code}{
  basicstyle=\latexprocodefont\small\color{latexpro@text},
  identifierstyle=\latexpro@ident,
  keywordstyle=\color{latexpro@keyword},
  keywordstyle=[2]\color{latexpro@builtin},
  keywordstyle=[3]\color{latexpro@constant},
  keywordstyle=[4]\color{latexpro@keyword}\latexpro@fnnext,
  stringstyle=\color{latexpro@string},
  commentstyle=\color{latexpro@comment}\itshape,
  emphstyle=\global\latexpro@fnfalse\latexpro@functionstyle,
  numbers=left,
  numberstyle=\scriptsize\latexprocodefont\color{latexpro@number},
  numbersep=1em,
  xleftmargin=1.6em,
  frame=none,
  aboveskip=0pt,
  belowskip=0pt,
  breaklines=true,
  breakatwhitespace=true,
  showstringspaces=false,
  tabsize=4,
  columns=fullflexible,
  keepspaces=true,
  upquote=true,
  % pdflatex: print the usual non-ASCII letters in code and comments
  extendedchars=true,
  literate=
    {æ}{{\ae}}1 {ø}{{\o}}1 {å}{{\aa}}1 {Æ}{{\AE}}1 {Ø}{{\O}}1 {Å}{{\AA}}1
    {ä}{{\"a}}1 {ö}{{\"o}}1 {ü}{{\"u}}1 {Ä}{{\"A}}1 {Ö}{{\"O}}1 {Ü}{{\"U}}1
    {é}{{\'e}}1 {è}{{\`e}}1 {ß}{{\ss}}1
    {—}{{-{}-}}1 {–}{{-}}1 {“}{{``}}1 {”}{{''}}1 {‘}{{`}}1 {’}{{'}}1
    {…}{{\ldots}}1 {×}{{$\times$}}1 {·}{{$\cdot$}}1
}

% ---------------------------------------------------------------------------
% Python code listings
% ---------------------------------------------------------------------------
\lstdefinestyle{latexpro-python}{
  style=latexpro-code,
  language=Python,
  deletekeywords={def,class,True,False,None,print},
  morekeywords={async,await,nonlocal,with,as,yield},
  % operators share the keyword colour
  otherkeywords={==,!=,<=,>=,**,//,+=,-=,*=,/=,->,=,+,-,*,/,\%,<,>,&,|,^,~,@},
  morekeywords=[2]{abs,all,any,bool,dict,enumerate,float,int,len,list,map,
    max,min,open,print,range,reversed,round,set,sorted,str,sum,tuple,type,
    zip,isinstance,super,input,filter,iter,next,repr,format,hash,id,divmod,pow},
  morekeywords=[3]{True,False,None,self,cls},
  morekeywords=[4]{def,class},
  morestring=[s]{"""}{"""},
  morestring=[s]{'''}{'''},
}
% \py{...}: same colours, no line numbers
\lstdefinestyle{latexpro-python-inline}{
  style=latexpro-python, numbers=none, basicstyle=\latexprocodefont\color{latexpro@text}}

\ExplSyntaxOn
% [caption=..] / [title=..] go in the header bar, every other option to listings
\tl_new:N \l__latexpro_code_caption_tl
\clist_new:N \l__latexpro_code_lst_clist
\bool_new:N \l__latexpro_code_span_bool
\bool_new:N \l__latexpro_code_filename_bool
\keys_define:nn { latexpro / code }
  {
    caption .tl_set:N = \l__latexpro_code_caption_tl ,
    title   .tl_set:N = \l__latexpro_code_caption_tl ,
    % [span]: the box may break across pages (default: kept in one piece)
    span    .bool_set:N = \l__latexpro_code_span_bool ,
    span    .default:n  = true ,
    % [filename=false]: no file name on the right of the header bar
    filename .bool_set:N = \l__latexpro_code_filename_bool ,
    filename .default:n  = true ,
  }
\AddToHook{begindocument/before}
  {
    \tcbset
      {
        latexpro-code-span/.code =
          { \bool_if:NT \l__latexpro_code_span_bool { \pgfkeysalso { breakable } } }
      }
  }
% Function names: every name written as name( or after def / class /
% function / procedure / algorithm somewhere in the file is coloured as a
% function wherever it appears as a name (not inside strings or comments).
\ior_new:N \g__latexpro_code_ior
\seq_new:N \l__latexpro_code_names_seq
\seq_new:N \l__latexpro_code_found_seq
\str_new:N \l__latexpro_code_name_str
\prg_new_conditional:Npnn \__latexpro_code_reserved:n #1 { F }
  {
    \str_case:nnTF {#1}
      {
        {if}{} {elif}{} {elseif}{} {while}{} {for}{} {foreach}{} {return}{}
        {and}{} {or}{} {not}{} {in}{} {is}{} {lambda}{} {yield}{} {assert}{}
        {del}{} {with}{} {except}{} {raise}{} {print}{} {then}{} {do}{}
        {def}{} {class}{} {function}{} {procedure}{} {algorithm}{}
        {until}{} {else}{} {to}{} {await}{} {import}{} {from}{} {as}{}
      }
      { \prg_return_true: } { \prg_return_false: }
  }
\cs_generate_variant:Nn \__latexpro_code_reserved:nF { V }
\cs_new_protected:Npn \__latexpro_code_harvest:n #1
  {
    \seq_clear:N \l__latexpro_code_names_seq
    \ior_open:NnT \g__latexpro_code_ior {#1}
      {
        \ior_str_map_inline:Nn \g__latexpro_code_ior
          {
            \regex_extract_all:nnN
              { (?: [A-Za-z_]\w* \s* \( ) | (?: (?:def|class|function|procedure|algorithm) \s+ [A-Za-z_]\w* ) }
              {##1} \l__latexpro_code_found_seq
            \seq_map_inline:Nn \l__latexpro_code_found_seq
              {
                \str_set:Nn \l__latexpro_code_name_str {####1}
                \regex_replace_once:nnN { \s* \( \Z } { } \l__latexpro_code_name_str
                \regex_replace_once:nnN
                  { \A (?:def|class|function|procedure|algorithm) \s+ } { }
                  \l__latexpro_code_name_str
                \__latexpro_code_reserved:VF \l__latexpro_code_name_str
                  {
                    \seq_if_in:NVF \l__latexpro_code_names_seq \l__latexpro_code_name_str
                      { \seq_put_right:NV \l__latexpro_code_names_seq \l__latexpro_code_name_str }
                  }
              }
          }
        \ior_close:N \g__latexpro_code_ior
      }
    \use:e
      {
        \exp_not:N \lstset
          { emph = { \seq_use:Nn \l__latexpro_code_names_seq { , } } }
      }
  }
% #1 language name, #2 star (no numbers), #3 options, #4 text for the right of
% the header when there is no caption (file name or empty)
\cs_new_protected:Npn \__latexpro_code_begin:nnnn #1#2#3#4
  {
    \tl_clear:N \l__latexpro_code_caption_tl
    \bool_set_false:N \l__latexpro_code_span_bool
    \bool_set_true:N \l__latexpro_code_filename_bool
    \keys_set_known:nnN { latexpro / code } {#3} \l__latexpro_code_lst_clist
    \bool_lazy_and:nnT
      { \tl_if_empty_p:N \l__latexpro_code_caption_tl }
      { \l__latexpro_code_filename_bool }
      { \tl_set:Nn \l__latexpro_code_caption_tl {#4} }
    \tcolorbox
      [
        latexpro-code ,
        latexpro-code-span ,
        title =
          {
            #1 \hfill
            { \color{latexpro@headerinfo} \l__latexpro_code_caption_tl }
          }
      ]
    \bool_if:NT #2 { \lstset { numbers = none , xleftmargin = 0pt } }
    \global \latexpro@fnfalse
  }
\cs_new_protected:Npn \__latexpro_code_end: { \endtcolorbox }
\cs_new:Npn \__latexpro_code_file:n #1
  { { \latexprocodefont \footnotesize \tl_to_str:n {#1} } }
\cs_new_protected:Npn \__latexpro_code_input:nnnnn #1#2#3#4#5
  {
    % #1 language, #2 style, #3 star, #4 options, #5 file
    \__latexpro_code_begin:nnnn {#1} {#3} {#4} { \__latexpro_code_file:n {#5} }
    \__latexpro_code_harvest:n {#5}
    \use:e
      {
        \exp_not:N \lstinputlisting
          [ style = #2 , \exp_not:V \l__latexpro_code_lst_clist ]
      }
      {#5}
    \__latexpro_code_end:
  }
% \python[options]{file.py};  \python* drops the line numbers
\NewDocumentCommand \python { s O{} m }
  {
    \bool_set:Nn \l_tmpa_bool {#1}
    \__latexpro_code_input:nnnnn { Python } { latexpro-python }
      \l_tmpa_bool {#2} {#3}
  }
% #1 options: sets the caption and the listings options for a tcblisting
\cs_new_protected:Npn \__latexpro_code_opts:n #1
  {
    \tl_clear:N \l__latexpro_code_caption_tl
    \bool_set_false:N \l__latexpro_code_span_bool
    \keys_set_known:nnN { latexpro / code } {#1} \l__latexpro_code_lst_clist
  }
% \begin{pythoncode}[options] ... \end{pythoncode}: tcolorbox reads the body
% verbatim (an \lstnewenvironment cannot sit inside a breakable box)
\AddToHook{begindocument/before}
  {
    \tcbuselibrary{listings}
    \DeclareTCBListing {pythoncode} { O{} }
      {
        latexpro-code ,
        listing~only ,
        code = { \__latexpro_code_opts:n {#1} \global \latexpro@fnfalse } ,
        latexpro-code-span ,
        before~upper = { \__latexpro_code_harvest:n { \kvtcb@listingfile } } ,
        title =
          {
            Python \hfill
            { \color{latexpro@headerinfo} \l__latexpro_code_caption_tl }
          } ,
        listing~options/.expanded =
          { style = latexpro-python , \exp_not:V \l__latexpro_code_lst_clist } ,
      }
  }
\ExplSyntaxOff
% \py{code} or \py|code| for a short piece of Python inside a sentence
\NewDocumentCommand\py{v}{\lstinline[style=latexpro-python-inline]{#1}}
% ---------------------------------------------------------------------------
% Pseudocode listings
% ---------------------------------------------------------------------------
% \pseudo[options]{file.txt} reads a plain-text pseudocode file and
%  * indents it by its keywords (lines after function/if..then/for/while/
%    repeat/else/..do are indented, end/else/until lines step back out),
%  * prints TeX commands such as \geq, \leq, \neq, \gets, \in, \alpha_i
%    as maths, and <=, >=, !=, <-, -> as the symbols,
%  * colours keywords, function names and // comments.
% A line that already holds $...$ is left for listings' mathescape.
% \pseudo* drops the line numbers.  \pseudoindentfalse keeps the file's own
% indentation instead of re-indenting it.
\lstdefinelanguage{latexpro-pseudo}{
  sensitive=false,
  morekeywords={return,returns,if,then,else,
    elseif,elif,end,endif,endfor,endwhile,endfunction,endprocedure,for,
    foreach,each,to,downto,by,step,do,in,while,repeat,until,loop,break,
    continue,and,or,not,xor,let,var,of,from,begin,goto,switch,case,default},
  % operators share the keyword colour
  otherkeywords={:=,==,=,+,-,/,\%},
  morekeywords=[2]{print,input,output,call,length,len,max,min,abs,swap},
  morekeywords=[3]{true,false,null,nil,none},
  % the name after these is coloured as a function name
  morekeywords=[4]{function,procedure,algorithm},
  morecomment=[l]{//},
  morecomment=[s]{/*}{*/},
  morestring=[b]",
}
\lstdefinestyle{latexpro-pseudo}{
  style=latexpro-code,
  language=latexpro-pseudo,
  mathescape=true,
}
\newif\ifpseudoindent \pseudoindenttrue
\ExplSyntaxOn
\cs_generate_variant:Nn \str_case:nnT { Vn , en }
\cs_generate_variant:Nn \str_foldcase:n { e }
\ior_new:N \g__latexpro_pseudo_ior
\iow_new:N \g__latexpro_pseudo_iow
\str_const:Ne \c__latexpro_pseudo_file_str { \c_sys_jobname_str -pseudo.tmp }
\str_const:Ne \c__latexpro_tab_str { \char_generate:nn { 9 } { 12 } }
\int_new:N  \l__latexpro_depth_int
\int_new:N  \l__latexpro_next_int
\str_new:N  \l__latexpro_line_str
\str_new:N  \l__latexpro_first_str
\str_new:N  \l__latexpro_last_str
\seq_new:N  \l__latexpro_words_seq
\bool_new:N \l__latexpro_open_bool

% first word that closes a block: the line is printed one step further out
\prg_new_conditional:Npnn \__latexpro_pseudo_closes:n #1 { T , TF }
  {
    \str_case:nnTF {#1}
      {
        {end}{} {endif}{} {endfor}{} {endwhile}{} {endfunction}{}
        {endprocedure}{} {endloop}{} {until}{} {else}{} {elseif}{}
        {elif}{} {done}{} {fi}{}
      }
      { \prg_return_true: } { \prg_return_false: }
  }
% first word that always opens a block
\prg_new_conditional:Npnn \__latexpro_pseudo_opens:n #1 { T , TF }
  {
    \str_case:nnTF {#1}
      {
        {function}{} {procedure}{} {algorithm}{} {repeat}{} {else}{}
        {loop}{} {begin}{} {switch}{} {case}{} {default}{}
      }
      { \prg_return_true: } { \prg_return_false: }
  }
% first word that opens a block unless it is a one-liner ("if x then y")
\prg_new_conditional:Npnn \__latexpro_pseudo_head:n #1 { T , TF }
  {
    \str_case:nnTF {#1}
      { {if}{} {elseif}{} {elif}{} {for}{} {foreach}{} {while}{} }
      { \prg_return_true: } { \prg_return_false: }
  }

% maths in a line that has no $...$ of its own:
%   a_i -> $a_i$,  \geq -> $\geq$,  <= >= != <- -> < > * -> symbols
\cs_new_protected:Npn \__latexpro_pseudo_math:N #1
  {
    \str_if_in:NnF #1 { $ }
      {
        \regex_replace_all:nnN
          { \b ([A-Za-z] _ (?: \{[^\}]*\} | [A-Za-z0-9]+ )) } { \$ \1 \$ } #1
        \regex_replace_all:nnN
          { (\\[A-Za-z]+ (?: \s* [_^] (?: \{[^\}]*\} | \\[A-Za-z]+ | \w ) )* ) }
          { \$ \1 \$ } #1
        \regex_replace_all:nnN { <= } { \$\\leq\$ } #1
        \regex_replace_all:nnN { >= } { \$\\geq\$ } #1
        \regex_replace_all:nnN { != } { \$\\neq\$ } #1
        \regex_replace_all:nnN { <- } { \$\\gets\$ } #1
        \regex_replace_all:nnN { -> } { \$\\to\$ } #1
        \regex_replace_all:nnN { ([<>]) } { \$\1\$ } #1
        \regex_replace_all:nnN { \* } { \$\\cdot\$ } #1
      }
  }
\cs_new_protected:Npn \__latexpro_pseudo_line:n #1
  {
    \str_set:Nn \l__latexpro_line_str {#1}
    \ifpseudoindent
      \exp_args:NNV \str_replace_all:Nnn \l__latexpro_line_str
        \c__latexpro_tab_str { ~ }
      \str_set:Ne \l__latexpro_line_str
        { \tl_trim_spaces:V \l__latexpro_line_str }
      \seq_set_split:NnV \l__latexpro_words_seq { ~ } \l__latexpro_line_str
      \seq_remove_all:Nn \l__latexpro_words_seq { }
      \str_set:Ne \l__latexpro_first_str
        { \str_foldcase:e { \seq_item:Nn \l__latexpro_words_seq { 1 } } }
      \str_set:Ne \l__latexpro_last_str
        { \str_foldcase:e { \seq_item:Nn \l__latexpro_words_seq { -1 } } }
      % "if(x" -> "if",  "x):" -> ":"
      \regex_replace_once:nnN { (.)\(.* } { \1 } \l__latexpro_first_str
      \regex_replace_once:nnN { .*: \Z } { : } \l__latexpro_last_str
      % C-style braces: "}" closes like end, a trailing "{" opens like then
      \str_if_eq:NNT \l__latexpro_first_str \c_right_brace_str
        { \str_set:Nn \l__latexpro_first_str { end } }
      \str_if_eq:NNT \l__latexpro_last_str \c_left_brace_str
        { \str_set:Nn \l__latexpro_last_str { then } }
      \exp_args:NV \__latexpro_pseudo_closes:nT \l__latexpro_first_str
        { \int_decr:N \l__latexpro_depth_int }
      \int_compare:nNnT \l__latexpro_depth_int < \c_zero_int
        { \int_zero:N \l__latexpro_depth_int }
      \bool_set_false:N \l__latexpro_open_bool
      \str_case:VnT \l__latexpro_last_str
        { {then}{} {do}{} {:}{} {begin}{} {repeat}{} {else}{} }
        { \bool_set_true:N \l__latexpro_open_bool }
      \exp_args:NV \__latexpro_pseudo_opens:nT \l__latexpro_first_str
        { \bool_set_true:N \l__latexpro_open_bool }
      \exp_args:NV \__latexpro_pseudo_head:nT \l__latexpro_first_str
        {
          % a one-liner ("if x then break") has then/do before its last word
          \seq_pop_right:NN \l__latexpro_words_seq \l_tmpa_tl
          \bool_set_true:N \l_tmpa_bool
          \seq_map_inline:Nn \l__latexpro_words_seq
            {
              \str_case:enT { \str_foldcase:n {##1} } { {then}{} {do}{} }
                { \bool_set_false:N \l_tmpa_bool }
            }
          \bool_if:NT \l_tmpa_bool
            { \bool_set_true:N \l__latexpro_open_bool }
        }
      \__latexpro_pseudo_math:N \l__latexpro_line_str
      \iow_now:Ne \g__latexpro_pseudo_iow
        {
          \str_if_empty:NF \l__latexpro_line_str
            { \prg_replicate:nn { 4 * \l__latexpro_depth_int } { \c_space_tl } }
          \l__latexpro_line_str
        }
      \bool_if:NT \l__latexpro_open_bool
        { \int_incr:N \l__latexpro_depth_int }
    \else
      % keep the file's own indentation
      \__latexpro_pseudo_math:N \l__latexpro_line_str
      \iow_now:Ne \g__latexpro_pseudo_iow { \l__latexpro_line_str }
    \fi
  }

% write the re-indented copy of #1 to \jobname-pseudo.tmp
\cs_new_protected:Npn \__latexpro_pseudo_prepare:n #1
  {
    \ior_open:Nn \g__latexpro_pseudo_ior {#1}
    \iow_open:Nn \g__latexpro_pseudo_iow { \c__latexpro_pseudo_file_str }
    \int_zero:N \l__latexpro_depth_int
    \ior_str_map_inline:Nn \g__latexpro_pseudo_ior
      { \__latexpro_pseudo_line:n {##1} }
    \iow_close:N \g__latexpro_pseudo_iow
    \ior_close:N \g__latexpro_pseudo_ior
  }
% #1 star bool, #2 options, #3 file, #4 header text when there is no caption
