% latex-pro.sty -- shortcut commands for maths documents
%
% Usage:  \usepackage{latex-pro}
%
% Commands
%   \bmat{a & b \\ c & d}          bmatrix  [ ... ]
%   \pmat{a & b \\ c & d}          pmatrix  ( ... )
%   \mat{a & b \\ c & d}           matrix in the current style (default round)
%   \usematb  \usematp             switch \mat and every matrix command to
%                                  square / round brackets (default round);
%                                  or \usepackage[square]{latex-pro}
%   \partialdiff[f]{x,y,...}       partial derivative of f w.r.t. the listed
%                                  variables; consecutive repeats collapse to
%                                  powers, e.g. {x,x,y} -> d^3 f / dx^2 dy
%   \hessian[f][x][v]{n}           Hessian matrix of f in n dimensions,
%                                  evaluated at the point v (default v;
%                                  pass [] as the third option to drop it).
%   \idmat{n}                      identity matrix; n a number -> written
%                                  out, otherwise general form with dots.
%
% Theorems and bold references
%   \begin{proposition} ... \end{proposition}   numbered environment
%   \proposition{prop:main}        bold "Proposition 3" (label -> its number)
%   \proposition{3}                bold "Proposition 3" (number written as is)
%   Same for theorem, lemma, corollary, definition, exercise, example, remark.
%   All share one counter. Option [bysection] numbers them 2.1, 2.2, ...
%   Rename with e.g. \renewcommand\propositionname{Sætning}.
%   \diff[f]{x,...}                ordinary derivative, same rules as
%                                  \partialdiff:  d^2 f / dx^2
%   \gradient[f][x][v]{n}          gradient row vector (df/dx_1 ... df/dx_n) at v
%   \jacobian[f][x][v]{m}{n}       m x n derivative matrix of f = (f_1..f_m)
%   \colvec[x]{n}  \rowvec[x]{n}   vector (x_1, ..., x_n) as column / row
%   \colvec[x,y]  \rowvec[1, 2]   vector with exactly the listed entries,
%                                  the row one printed as (1, 2)
%   \genmat[a]{m}{n}               general m x n matrix with entries a_ij
%   \symmat[a]{n}                  general symmetric matrix (a_ji below diag)
%   \symmat{e & 0 \\ 0 & d}        symmetric matrix from all its rows ...
%   \symmat{1 & 2 \\ 3}            ... or from just its upper triangle
%   \symmat[e,d]{2}                diagonal matrix with e, d on the diagonal
%   \diagmat{e, d}                 same, size taken from the list
%   \N \Z \Q \R                    number sets (blackboard bold)
%   \norm{x} \abs{x}               ||x||, |x|   (starred: auto-sized)
%   \inner{u}{v}                   <u, v>
%   \set{1,2,3}                    {1,2,3}
%   \setof{x \in S}{p(x)}          {x in S | p(x)}
%   A\tp                           transpose A^T
%   \map{f}{S}{T}                  f : S -> T
%   \defeq                         :=
%   \argmin \argmax                operators, subscripts go underneath
%   \minimize{f(x)}{x \in C \\ ...} min with stacked constraints below
%   \maximize{f(x)}{...}           same with max
%   \ball{v}{r}  \dist{u}{v}       B(v, r), d(u, v)
%   \interior{S}  \bd{S}           interior S°, boundary dS
%   \Rx  \Rx[t]                    polynomials R[x], R[t]
%
%   For \hessian, \idmat, \gradient, \jacobian, \colvec, \rowvec, \genmat,
%   \symmat a number
%   writes every entry, anything else (n, m, ...) gives the dotted form.
%
\NeedsTeXFormat{LaTeX2e}[2020/10/01]
\ProvidesPackage{latex-pro}[2026/11/03 v0.1 Maths shortcut commands]

\newif\iflatexpro@bysection
\DeclareOption{bysection}{\latexpro@bysectiontrue}
% bracket style for the built-in matrix commands: round (default) or square
\def\latexpro@matenv{pmatrix}
\DeclareOption{round}{\def\latexpro@matenv{pmatrix}}
\DeclareOption{square}{\def\latexpro@matenv{bmatrix}}
\ProcessOptions\relax

\RequirePackage{amsmath}
\RequirePackage{amsthm}
\RequirePackage{amssymb}
\RequirePackage{mathtools}

% ---------------------------------------------------------------------------
% Matrices
% ---------------------------------------------------------------------------
\NewDocumentCommand\bmat{m}{\begin{bmatrix}#1\end{bmatrix}}
\NewDocumentCommand\pmat{m}{\begin{pmatrix}#1\end{pmatrix}}

% \mat{...}: matrix in the current bracket style. Every built-in matrix
% command (\hessian, \idmat, \gradient, \jacobian, \colvec, \rowvec,
% \genmat, \symmat, \diagmat) uses it.
%   \usematb    square brackets from here on (or inside a group)
%   \usematp    round brackets (the default)
%   \usepackage[square]{latex-pro} sets square brackets for the whole file
\NewDocumentCommand\mat{m}{\begin{\latexpro@matenv}#1\end{\latexpro@matenv}}
\NewDocumentCommand\usematb{}{\def\latexpro@matenv{bmatrix}}
\NewDocumentCommand\usematp{}{\def\latexpro@matenv{pmatrix}}

\ExplSyntaxOn

% ---------------------------------------------------------------------------
% Partial derivatives
% ---------------------------------------------------------------------------
\seq_new:N  \l__mathsc_vars_seq
\tl_new:N   \l__mathsc_denom_tl
\tl_new:N   \l__mathsc_prev_tl
\tl_new:N   \l__mathsc_cur_tl
\int_new:N  \l__mathsc_run_int
\int_new:N  \l__mathsc_order_int
\tl_new:N   \l__mathsc_frac_tl
\tl_set:Nn  \l__mathsc_frac_tl { \frac }
\tl_new:N   \l__mathsc_d_tl
\tl_set:Nn  \l__mathsc_d_tl { \partial }

% append "\partial <var>^{run}" for the current run of equal variables
\cs_new_protected:Npn \__mathsc_flush_run:
  {
    \int_compare:nNnT { \l__mathsc_run_int } > { 0 }
      {
        \tl_put_right:Ne \l__mathsc_denom_tl
          {
            \exp_not:V \l__mathsc_d_tl
            \exp_not:V \l__mathsc_prev_tl
            \int_compare:nNnT { \l__mathsc_run_int } > { 1 }
              { ^{ \int_use:N \l__mathsc_run_int } }
          }
      }
  }

% #1 = function (may be empty), #2 = comma list of variables
\cs_new_protected:Npn \mathsc_partial:nn #1#2
  {
    \seq_set_from_clist:Nn \l__mathsc_vars_seq {#2}
    \int_set:Nn \l__mathsc_order_int { \seq_count:N \l__mathsc_vars_seq }
    \tl_clear:N \l__mathsc_denom_tl
    \tl_clear:N \l__mathsc_prev_tl
    \int_zero:N \l__mathsc_run_int
    \seq_map_inline:Nn \l__mathsc_vars_seq
      {
        \tl_set:Nn \l__mathsc_cur_tl {##1}
        \tl_if_eq:NNTF \l__mathsc_cur_tl \l__mathsc_prev_tl
          { \int_incr:N \l__mathsc_run_int }
          {
            \__mathsc_flush_run:
            \tl_set_eq:NN \l__mathsc_prev_tl \l__mathsc_cur_tl
            \int_set:Nn \l__mathsc_run_int { 1 }
          }
      }
    \__mathsc_flush_run:
    \use:e
      {
        \exp_not:V \l__mathsc_frac_tl
          {
            \exp_not:V \l__mathsc_d_tl
            \int_compare:nNnT { \l__mathsc_order_int } > { 1 }
              { ^{ \int_use:N \l__mathsc_order_int } }
            \exp_not:n {#1}
          }
          { \exp_not:V \l__mathsc_denom_tl }
      }
  }

\NewDocumentCommand \partialdiff { O{} m }
  { \mathsc_partial:nn {#1} {#2} }

% \diff[f]{x,x}: same as \partialdiff but with an upright d (ordinary
% derivative), e.g. d^2 f / dx^2
\NewDocumentCommand \diff { O{} m }
  {
    \group_begin:
      \tl_set:Nn \l__mathsc_d_tl { \mathrm { d } }
      \mathsc_partial:nn {#1} {#2}
    \group_end:
  }

% ---------------------------------------------------------------------------
% Matrix builder (shared by \hessian, \idmat, \gradient, \jacobian, \colvec, \genmat, \symmat)
% ---------------------------------------------------------------------------
\seq_new:N \l__mathsc_idx_seq
\tl_new:N  \l__mathsc_body_tl
\tl_new:N  \l__mathsc_row_tl
\tl_new:N  \l__mathsc_rowsep_tl
\tl_const:Nn \c__mathsc_dots_tl { \q__mathsc_dots }
\tl_new:N  \l__mathsc_r_tl
\tl_new:N  \l__mathsc_c_tl

% filled in by each command: #1 = row index, #2 = column index
\cs_new_protected:Npn \__mathsc_cell:nn #1#2 { }

\cs_new_protected:Npn \__mathsc_put_cell:nn #1#2
  {
    \tl_set:Nn \l__mathsc_r_tl {#1}
    \tl_set:Nn \l__mathsc_c_tl {#2}
    \tl_if_eq:NNTF \l__mathsc_r_tl \c__mathsc_dots_tl
      {
        \tl_if_eq:NNTF \l__mathsc_c_tl \c__mathsc_dots_tl
          { \tl_put_right:Nn \l__mathsc_row_tl { \ddots } }
          { \tl_put_right:Nn \l__mathsc_row_tl { \vdots } }
      }
      {
        \tl_if_eq:NNTF \l__mathsc_c_tl \c__mathsc_dots_tl
          { \tl_put_right:Nn \l__mathsc_row_tl { \cdots } }
          { \tl_put_right:Ne \l__mathsc_row_tl { \__mathsc_cell:nn {#1} {#2} } }
      }
  }

% Fill seq #1 with the indices for a size #2:
% a number -> 1, 2, ..., n;  otherwise 1, 2, dots, n.
\cs_new_protected:Npn \__mathsc_indices:Nn #1#2
  {
    \regex_match:nnTF { \A \s* \d+ \s* \Z } {#2}
      {
        \seq_clear:N #1
        \int_step_inline:nn {#2} { \seq_put_right:Nn #1 {##1} }
      }
      { \seq_set_split:Nnn #1 { , } { 1 , 2 , \q__mathsc_dots , #2 } }
  }

% Build the body of an m x n matrix into \l__mathsc_body_tl,
% one \__mathsc_cell:nn {row} {col} per entry.
\seq_new:N \l__mathsc_cidx_seq
\cs_new_protected:Npn \__mathsc_grid:nn #1#2
  {
    \__mathsc_indices:Nn \l__mathsc_idx_seq  {#1}
    \__mathsc_indices:Nn \l__mathsc_cidx_seq {#2}
    \tl_clear:N \l__mathsc_body_tl
    \seq_map_inline:Nn \l__mathsc_idx_seq
      {
        \tl_clear:N \l__mathsc_row_tl
        \seq_map_inline:Nn \l__mathsc_cidx_seq
          {
            \tl_if_empty:NF \l__mathsc_row_tl
              { \tl_put_right:Nn \l__mathsc_row_tl { & } }
            \__mathsc_put_cell:nn {##1} {####1}
          }
        \tl_if_empty:NF \l__mathsc_body_tl
          { \tl_put_right:NV \l__mathsc_body_tl \l__mathsc_rowsep_tl }
        \tl_put_right:NV \l__mathsc_body_tl \l__mathsc_row_tl
      }
  }
\cs_new_protected:Npn \__mathsc_square:n #1 { \__mathsc_grid:nn {#1} {#1} }

% ---------------------------------------------------------------------------
% Hessian
% ---------------------------------------------------------------------------
% #1 = function, #2 = variable symbol, #3 = dimension
\cs_new_protected:Npn \mathsc_hessian:nnn #1#2#3
  {
    \group_begin:
      \cs_set:Npn \__mathsc_cell:nn ##1##2
        { \exp_not:n { \partialdiff [#1] { #2 \sb {##1} , #2 \sb {##2} } } }
      \tl_set:Nn \l__mathsc_rowsep_tl
        { \\ \noalign { \skip_vertical:n { 1ex } } }
      \__mathsc_square:n {#3}
      \tl_set:Nn \l__mathsc_frac_tl { \dfrac }
      \exp_args:NV \mat \l__mathsc_body_tl
    \group_end:
  }

% \hessian[f][x][v]{n}  -- third optional = point; [] leaves it out
\NewDocumentCommand \hessian { O{f} O{x} O{v} m }
  {
    \tl_if_blank:nTF {#3}
      { \mathsc_hessian:nnn {#1} {#2} {#4} }
      { \mathsc_hessian:nnn { #1 ( #3 ) } {#2} {#4} }
  }

% ---------------------------------------------------------------------------
% Identity matrix
% ---------------------------------------------------------------------------
% \idmat{n}: n a number -> written out in full, otherwise general form
\cs_new_protected:Npn \mathsc_idmat:n #1
  {
    \group_begin:
      \cs_set:Npn \__mathsc_cell:nn ##1##2
        { \str_if_eq:nnTF {##1} {##2} { 1 } { 0 } }
      \tl_set:Nn \l__mathsc_rowsep_tl { \\ }
      \__mathsc_square:n {#1}
      \exp_args:NV \mat \l__mathsc_body_tl
    \group_end:
  }
\NewDocumentCommand \idmat { m } { \mathsc_idmat:n {#1} }

% ---------------------------------------------------------------------------
% Vectors, general matrices and the gradient
% ---------------------------------------------------------------------------
% \colvec[x]{n}: column vector (x_1, ..., x_n)
% \colvec[x,y]  / \colvec[1, 2]: column vector with exactly those entries
% \rowvec[x,y] gives the row vector (x, y), commas printed.
% A list is used when the option has a comma or no size {n} follows.
% #1 = option, #2 = size (empty: none given), #3 = column (c) / row (r)
\cs_new_protected:Npn \mathsc_vec:nnn #1#2#3
  {
    \group_begin:
      \tl_set:Nn \l__mathsc_rowsep_tl { \\ }
      \bool_set_false:N \l__mathsc_explicit_bool
      \tl_if_empty:nT {#2} { \bool_set_true:N \l__mathsc_explicit_bool }
      \tl_if_in:nnT {#1} { , } { \bool_set_true:N \l__mathsc_explicit_bool }
      \bool_if:NTF \l__mathsc_explicit_bool
        {
          \seq_set_from_clist:Nn \l__mathsc_items_seq {#1}
          \tl_set:Ne \l__mathsc_body_tl
            {
              \str_if_eq:nnTF {#3} { c }
                { \seq_use:Nn \l__mathsc_items_seq { \\ } }
                { \seq_use:Nn \l__mathsc_items_seq { , ~ } }
            }
        }
        {
          \str_if_eq:nnTF {#3} { c }
            {
              \cs_set:Npn \__mathsc_cell:nn ##1##2 { \exp_not:n {#1} \sb {##1} }
              \__mathsc_grid:nn {#2} { 1 }
            }
            {
              \cs_set:Npn \__mathsc_cell:nn ##1##2 { \exp_not:n {#1} \sb {##2} }
              \__mathsc_grid:nn { 1 } {#2}
            }
        }
      \exp_args:NV \mat \l__mathsc_body_tl
    \group_end:
  }
% the size {n} is optional: look for a following brace group
\cs_new_protected:Npn \__mathsc_vec_peek:nn #1#2
  {
    \peek_catcode:NTF \c_group_begin_token
      { \__mathsc_vec_size:nnn {#1} {#2} }
      { \mathsc_vec:nnn {#1} { } {#2} }
  }
\cs_new_protected:Npn \__mathsc_vec_size:nnn #1#2#3
  { \mathsc_vec:nnn {#1} {#3} {#2} }
\NewDocumentCommand \colvec { O{x} } { \__mathsc_vec_peek:nn {#1} { c } }
\NewDocumentCommand \rowvec { O{x} } { \__mathsc_vec_peek:nn {#1} { r } }

% \genmat[a]{m}{n}: general m x n matrix with entries a_{ij}
\NewDocumentCommand \genmat { O{a} m m }
  {
    \group_begin:
      \cs_set:Npn \__mathsc_cell:nn ##1##2
        { \exp_not:n {#1} \sb { ##1 ##2 } }
      \tl_set:Nn \l__mathsc_rowsep_tl { \\ }
      \__mathsc_grid:nn {#2} {#3}
      \exp_args:NV \mat \l__mathsc_body_tl
    \group_end:
  }

% \gradient[f][x][v]{n}: row vector of partial derivatives at v, in round
% brackets (current matrix style), as the IMO26 notes write the gradient (it is the 1 x n
% derivative f'(v))
\cs_new_protected:Npn \mathsc_gradient:nnn #1#2#3
  {
    \group_begin:
      \cs_set:Npn \__mathsc_cell:nn ##1##2
        { \exp_not:n { \partialdiff [#1] { #2 \sb {##2} } } }
      \tl_set:Nn \l__mathsc_rowsep_tl { \\ }
      \__mathsc_grid:nn { 1 } {#3}
      \tl_set:Nn \l__mathsc_frac_tl { \dfrac }
      \exp_args:NV \mat \l__mathsc_body_tl
    \group_end:
  }
\NewDocumentCommand \gradient { O{f} O{x} O{v} m }
  {
    \tl_if_blank:nTF {#3}
      { \mathsc_gradient:nnn {#1} {#2} {#4} }
      { \mathsc_gradient:nnn { #1 ( #3 ) } {#2} {#4} }
  }

% \jacobian[f][x][v]{m}{n}: the m x n derivative matrix f'(v) of
% f = (f_1, ..., f_m), entries d f_i(v) / d x_j
\cs_new_protected:Npn \mathsc_jacobian:nnnnn #1#2#3#4#5
  {
    \group_begin:
      \cs_set:Npn \__mathsc_cell:nn ##1##2
        {
          \exp_not:n { \partialdiff } [ \exp_not:n {#1} \sb {##1} \exp_not:n {#3} ]
            { \exp_not:n {#2} \sb {##2} }
        }
      \tl_set:Nn \l__mathsc_rowsep_tl
        { \\ \noalign { \skip_vertical:n { 1ex } } }
      \__mathsc_grid:nn {#4} {#5}
      \tl_set:Nn \l__mathsc_frac_tl { \dfrac }
      \exp_args:NV \mat \l__mathsc_body_tl
    \group_end:
  }
\NewDocumentCommand \jacobian { O{f} O{x} O{v} m m }
  {
    \tl_if_blank:nTF {#3}
      { \mathsc_jacobian:nnnnn {#1} {#2} { } {#4} {#5} }
      { \mathsc_jacobian:nnnnn {#1} {#2} { (#3) } {#4} {#5} }
  }

% ---------------------------------------------------------------------------
% Symmetric matrices
% ---------------------------------------------------------------------------
% \symmat[a]{n}            general symmetric n x n matrix: a_{ij} on and
%                          above the diagonal, mirrored (a_{ji}) below it
% \symmat{e & 0 \\ 0 & d}  give the whole matrix row by row ...
% \symmat{1 & 2 & 3 \\ 4 & 5 \\ 6}
%                          ... or only the upper triangle (diagonal included);
%                          either way the part below the diagonal is the
%                          mirror of the part above it, so the result is
%                          always symmetric
\prop_new:N \l__mathsc_pos_prop
\prop_new:N \l__mathsc_entry_prop
\seq_new:N  \l__mathsc_rows_seq
\seq_new:N  \l__mathsc_items_seq
\int_new:N  \l__mathsc_i_int
\int_new:N  \l__mathsc_j_int
\bool_new:N \l__mathsc_explicit_bool
\bool_new:N \l__mathsc_full_bool

% position of an index (1, 2, ..., n) in the index list, for comparing
\cs_new:Npn \__mathsc_pos:n #1 { \prop_item:Nn \l__mathsc_pos_prop {#1} }

\cs_new_protected:Npn \mathsc_symmat:nn #1#2
  {
    \group_begin:
      \tl_set:Nn \l__mathsc_rowsep_tl { \\ }
      \bool_set_false:N \l__mathsc_explicit_bool
      \tl_if_in:nnT {#2} { & } { \bool_set_true:N \l__mathsc_explicit_bool }
      \tl_if_in:nnT {#2} { \\ } { \bool_set_true:N \l__mathsc_explicit_bool }
      \bool_if:NTF \l__mathsc_explicit_bool
        {
          % explicit entries: the full matrix, or just its upper triangle
          \seq_set_split:Nnn \l__mathsc_rows_seq { \\ } {#2}
          \seq_remove_all:Nn \l__mathsc_rows_seq { }
          % full matrix given <=> last row has n entries
          \seq_set_split:Nne \l__mathsc_items_seq { & }
            { \seq_item:Nn \l__mathsc_rows_seq { -1 } }
          \bool_set:Nn \l__mathsc_full_bool
            {
              \int_compare_p:nNn { \seq_count:N \l__mathsc_items_seq }
                = { \seq_count:N \l__mathsc_rows_seq }
            }
          \prop_clear:N \l__mathsc_entry_prop
          \int_zero:N \l__mathsc_i_int
          \seq_map_inline:Nn \l__mathsc_rows_seq
            {
              \int_incr:N \l__mathsc_i_int
              \bool_if:NTF \l__mathsc_full_bool
                { \int_set:Nn \l__mathsc_j_int { 1 } }
                { \int_set_eq:NN \l__mathsc_j_int \l__mathsc_i_int }
              \seq_set_split:Nnn \l__mathsc_items_seq { & } {##1}
              \seq_map_inline:Nn \l__mathsc_items_seq
                {
                  \prop_put:Nen \l__mathsc_entry_prop
                    { \int_use:N \l__mathsc_i_int , \int_use:N \l__mathsc_j_int }
                    {####1}
                  \int_incr:N \l__mathsc_j_int
                }
            }
          \cs_set:Npn \__mathsc_cell:nn ##1##2
            {
              \int_compare:nNnTF {##1} > {##2}
                { \prop_item:Nn \l__mathsc_entry_prop { ##2 , ##1 } }
                { \prop_item:Nn \l__mathsc_entry_prop { ##1 , ##2 } }
            }
          \exp_args:Ne \__mathsc_square:n { \seq_count:N \l__mathsc_rows_seq }
        }
        {
          % general form a_{ij}
          \__mathsc_indices:Nn \l__mathsc_idx_seq {#2}
          \prop_clear:N \l__mathsc_pos_prop
          \int_zero:N \l__mathsc_i_int
          \seq_map_inline:Nn \l__mathsc_idx_seq
            {
              \int_incr:N \l__mathsc_i_int
              \prop_put:Nne \l__mathsc_pos_prop {##1} { \int_use:N \l__mathsc_i_int }
            }
          \cs_set:Npn \__mathsc_cell:nn ##1##2
            {
              \exp_not:n {#1}
              \int_compare:nNnTF { \__mathsc_pos:n {##1} } > { \__mathsc_pos:n {##2} }
                { \sb { ##2 ##1 } }
                { \sb { ##1 ##2 } }
            }
          \__mathsc_square:n {#2}
        }
      \exp_args:NV \mat \l__mathsc_body_tl
    \group_end:
  }
% \symmat[e,d]{2}: a comma list in the option gives the diagonal matrix
% with those entries (0 elsewhere). For a letter size, list the entries for
% rows 1, 2 and n:  \symmat[d_1,d_2,d_n]{n}
\prop_new:N \l__mathsc_diag_prop
\cs_new_protected:Npn \mathsc_symdiag:nn #1#2
  {
    \group_begin:
      \seq_set_from_clist:Nn \l__mathsc_items_seq {#1}
      \__mathsc_indices:Nn \l__mathsc_idx_seq {#2}
      \seq_remove_all:Nn \l__mathsc_idx_seq { \q__mathsc_dots }
      \prop_clear:N \l__mathsc_diag_prop
      \int_zero:N \l__mathsc_i_int
      \seq_map_inline:Nn \l__mathsc_idx_seq
        {
          \int_incr:N \l__mathsc_i_int
          \prop_put:Nne \l__mathsc_diag_prop {##1}
            { \seq_item:Nn \l__mathsc_items_seq { \l__mathsc_i_int } }
        }
      \cs_set:Npn \__mathsc_cell:nn ##1##2
        {
          \str_if_eq:nnTF {##1} {##2}
            { \prop_item:Nn \l__mathsc_diag_prop {##1} }
            { 0 }
        }
      \tl_set:Nn \l__mathsc_rowsep_tl { \\ }
      \__mathsc_square:n {#2}
      \exp_args:NV \mat \l__mathsc_body_tl
    \group_end:
  }
\NewDocumentCommand \symmat { O{a} m }
  {
    \tl_if_in:nnTF {#1} { , }
      { \mathsc_symdiag:nn {#1} {#2} }
      { \mathsc_symmat:nn {#1} {#2} }
  }

% \diagmat{e, d, ...}: diagonal matrix with the listed entries, 0 elsewhere
% (same as \symmat[e,d,...]{<number of entries>})
\NewDocumentCommand \diagmat { m }
  {
    \seq_set_from_clist:Nn \l__mathsc_items_seq {#1}
    \exp_args:Nne \mathsc_symdiag:nn {#1} { \seq_count:N \l__mathsc_items_seq }
  }

\ExplSyntaxOff

% ---------------------------------------------------------------------------
% Theorem environments and bold references
% ---------------------------------------------------------------------------
% \proposition{x} is a reference, \begin{proposition} is the environment:
% the env/<name>/begin hook raises a flag just before \begin calls
% \proposition, so the one command can tell which use it is.
\newcounter{latexprothm}
\iflatexpro@bysection \counterwithin{latexprothm}{section} \fi
\newif\iflatexpro@envstart

% #1 = reference text (bold), #2 = label
\newcommand\latexpro@reflink[2]{\textbf{#1}}
\AtBeginDocument{%
  \@ifpackageloaded{hyperref}%
    {\renewcommand\latexpro@reflink[2]{\hyperref[#2]{\textbf{#1}}}}{}}

\ExplSyntaxOn
% #1 = kind (proposition, ...), #2 = label or literal number
\cs_new_protected:Npn \latexpro_thmref:nn #1#2
  {
    \cs_if_exist:cTF { r@#2 }
      { \latexpro_thmref_label:nn {#1} {#2} }
      {
        \regex_match:nnTF { \A \s* [0-9]+ (\.[0-9]+)* \s* \Z } {#2}
          { \textbf { \mbox { \use:c { #1name } } \nobreakspace #2 } }
          { \latexpro_thmref_label:nn {#1} {#2} }
      }
  }
\cs_new_protected:Npn \latexpro_thmref_label:nn #1#2
  {
    \latexpro@reflink
      { \mbox { \use:c { #1name } } \nobreakspace
        \cs_if_exist:NTF \hyperref { \ref*{#2} } { \ref{#2} } }
      {#2}
  }

% #1 = kind, #2 = printed name, #3 = amsthm style
\cs_new_protected:Npn \latexpro_newthm:nnn #1#2#3
  {
    \cs_if_exist:cF { #1name } { \cs_new:cpn { #1name } {#2} }
    \theoremstyle {#3}
    \newtheorem { latexpro@#1 } [ latexprothm ] { \use:c { #1name } }
    \AddToHook { env/#1/begin } { \latexpro@envstarttrue }
    \exp_args:Nc \NewDocumentCommand { #1 } { }
      {
        \iflatexpro@envstart
          \latexpro@envstartfalse
          \exp_after:wN \use_i:nn
        \else
          \exp_after:wN \use_ii:nn
        \fi
          { \use:c { latexpro@#1 } }
          { \latexpro_thmref:nn {#1} }
      }
    \cs_new_protected:cpn { end#1 } { \use:c { endlatexpro@#1 } }
  }

\latexpro_newthm:nnn { theorem }     { Theorem }     { plain }
\latexpro_newthm:nnn { proposition } { Proposition } { plain }
\latexpro_newthm:nnn { lemma }       { Lemma }       { plain }
\latexpro_newthm:nnn { corollary }   { Corollary }   { plain }
\latexpro_newthm:nnn { definition }  { Definition }  { definition }
\latexpro_newthm:nnn { exercise }    { Exercise }    { definition }
\latexpro_newthm:nnn { example }     { Example }     { definition }
\latexpro_newthm:nnn { remark }      { Remark }      { remark }
\ExplSyntaxOff

% ---------------------------------------------------------------------------
% Number sets, delimiters, operators
% ---------------------------------------------------------------------------
\NewDocumentCommand\N{}{\mathbb{N}}
\NewDocumentCommand\Z{}{\mathbb{Z}}
\NewDocumentCommand\Q{}{\mathbb{Q}}
\NewDocumentCommand\R{}{\mathbb{R}}

% \norm{x}, \abs{x}, \inner{u}{v}, \set{1,2,3}, \setof{x \in S}{p(x)}
% Starred forms (\norm*{...}) grow with the contents; [\big] etc. fix the size.
\DeclarePairedDelimiter\norm{\lVert}{\rVert}
\DeclarePairedDelimiter\abs{\lvert}{\rvert}
\DeclarePairedDelimiterX\inner[2]{\langle}{\rangle}{#1, #2}
\DeclarePairedDelimiter\set{\{}{\}}
\DeclarePairedDelimiterX\setof[2]{\{}{\}}{#1 \;\delimsize\vert\; #2}

% transpose: A\tp -> A^T
\NewDocumentCommand\tp{}{^{T}}
% definition: x \defeq y -> x := y
\NewDocumentCommand\defeq{}{\coloneqq}
% \map{f}{S}{T} -> f : S -> T
\NewDocumentCommand\map{mmm}{#1\colon #2\to #3}

\DeclareMathOperator*{\argmin}{arg\,min}
\DeclareMathOperator*{\argmax}{arg\,max}

% Optimisation problems, constraints stacked under min/max:
% \minimize{f(x)}{x \in C \\ g(x) \le 0}
\NewDocumentCommand\minimize{mm}{\min_{\substack{#2}}\; #1}
\NewDocumentCommand\maximize{mm}{\max_{\substack{#2}}\; #1}

% ---------------------------------------------------------------------------
% Subsets of R^d and polynomials (IMO26 notation)
% ---------------------------------------------------------------------------
% \ball{v}{\epsilon} -> B(v, epsilon), the open ball
\NewDocumentCommand\ball{mm}{B(#1, #2)}
% \dist{u}{v} -> d(u, v)
\NewDocumentCommand\dist{mm}{d(#1, #2)}
% \interior{S} -> S°,  \bd{S} -> boundary \partial S
\NewDocumentCommand\interior{m}{{#1}^{\circ}}
\NewDocumentCommand\bd{m}{\partial #1}
% \Rx -> R[x], polynomials;  \Rx[t] -> R[t]
\NewDocumentCommand\Rx{O{x}}{\mathbb{R}[#1]}

