# Build output of tests/run.sh (tests and example PDFs; CI uploads these)
build/

# Built PDFs are never committed: they change on every edit and cause merge
# conflicts. Download them from the "pdfs" artifact of the Tests workflow,
# or run tests/run.sh.
*.pdf

